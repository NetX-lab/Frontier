+            "gids": gid_table(p)} for p in (d / "ports").glob("*")} for d in SYSFS_INFINIBAND.glob("*")}
+        result["ucx_devices"] = roce_v2_ipv4_ports(rdma)
+        if not result["ucx_devices"]:
+            raise RuntimeError("No ACTIVE RoCE v2 IPv4 port")
