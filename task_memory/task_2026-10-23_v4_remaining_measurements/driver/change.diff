+        raise error
+
+    cls = type('NativeProfileFailure', (), {'profile': fail})
+    c.install_profile(cls)
+    with pytest.raises(RuntimeError) as caught:
+        cls.profile(p.native.worker)
+    assert caught.value is error
+
+    class Broken:
