+class PositionCyclicRouting(RoutingStrategy):
+    """Select experts from actual logical positions and score unbiased logits."""
+
+    def route_tokens(
+        self,
+        hidden_states: torch.Tensor,
+        router_logits: torch.Tensor,
+        top_k: int,
+        indices_type: torch.dtype | None = None,
+        *,
+        positions: torch.Tensor | None = None,
+        renormalize: bool = True,
+        routed_scaling_factor: float = 1.0,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if router_logits.ndim != 2:
+            raise ValueError("position_cyclic requires logits with shape [M, E]")
+        rows, experts = router_logits.shape
+        if not 1 <= top_k <= experts:
+            raise ValueError("position_cyclic requires 1 <= top_k <= num_experts")
+        if positions is None:
+            raise ValueError("position_cyclic requires scoped routing_positions")
+        if positions.shape != (rows,) or positions.dtype not in (
+            torch.int8, torch.int16, torch.int32, torch.int64
+        ):
+            raise ValueError("routing_positions must be a signed integer tensor [M]")
+        if positions.device != router_logits.device:
+            raise ValueError("routing_positions and logits must be on the same device")
+        ids = (positions.to(torch.int64)[:, None] * top_k
+               + torch.arange(top_k, device=positions.device)) % experts
+        weights = torch.sigmoid(router_logits.float().gather(1, ids))
+        if renormalize:
+            weights = weights / weights.sum(dim=-1, keepdim=True)
+        weights = weights * routed_scaling_factor
+        return weights, ids.to(indices_type or torch.int32)
+
+
