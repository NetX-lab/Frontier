diff --git a/frontier/kv_cache_transfer/analytical_kv_cache_transfer_predictor.py b/frontier/kv_cache_transfer/analytical_kv_cache_transfer_predictor.py
index b55a522..233508b 100644
--- a/frontier/kv_cache_transfer/analytical_kv_cache_transfer_predictor.py
