+def _affine_service(record, operand_bytes, *, positive_slope=True):
+    a, b = record["a_ms"], record["b_ms_per_byte"]
+    lower, upper = record["range_bytes"]
+    if (any(not math.isfinite(v) for v in (a, b, lower, upper)) or a < 0 or b < 0
+            or (positive_slope and b == 0) or not 0 < lower <= operand_bytes <= upper):
+        raise ValueError("Invalid affine coefficients or unsupported physical byte range")
+    if record["design_matrix_rank"] != 2 or record["distinct_sizes"] < 3:
+        raise ValueError("Affine service requires identified slope/intercept and three sizes")
+    qualification = record["qualification"]
+    if (qualification["status"] != "PASS" or not qualification["independent"]
+            or not qualification["observations"] or not record["calibration_receipt"]):
+        raise ValueError("Affine service requires independent qualification and raw receipts")
+    if not all(math.isfinite(v) for v in record["signed_residuals_ms"]):
+        raise ValueError("Signed calibration residuals must remain finite and preserved")
+    return a + b * operand_bytes
+
+
+def estimate_plan_local_ms(scenario: Scenario):
+    """Measured HBM proxies, or calibrated full-device TP8 ring approximation."""
+    plan, params = scenario.collective.plan, scenario.collective.local_parameters
+    if params["context"] != plan["context"] or not params["model_identity"]:
+        raise ValueError("Local model/native context identity mismatch")
+    if params["evidence_kind"] not in ("native_measurement", "cpu_fixture"):
+        raise ValueError("Local service requires explicit measured or CPU-fixture evidence")
+    phase, tensors, sizes = plan["phase"], plan["tensors"], plan["sizes"]
+    if phase in ("shared_tp", "routed_tp"):
+        cfg = params["tp_nvlink"]
+        bw, efficiency = cfg["nvlink_one_way_bw_GBps"], cfg["nvlink_efficiency"]
+        latency, overhead = cfg["nvlink_latency_us"], cfg["nvlink_allreduce_launch_overhead_us"]
+        if (not all(math.isfinite(v) for v in (bw, efficiency, latency, overhead))
+                or bw <= 0 or not 0 < efficiency <= 1 or min(latency, overhead) < 0):
+            raise ValueError("Invalid calibrated TP8 effective NVLink parameters")
+        bytes_per_row = tensors[0]["columns"] * tensors[0]["element_size"]
+        values = []
+        for rows in sizes:
+            operand = rows * bytes_per_row
+            fitted = _affine_service(cfg["fit"], operand)
+            modeled = (2 * (8-1) / 8 * operand / (bw * efficiency * 1e9) * 1000
+                       + 2 * (8-1) * (latency + overhead) / 1000)
+            if not math.isclose(fitted, modeled, rel_tol=1e-10, abs_tol=1e-12):
+                raise ValueError("TP8 effective fields disagree with their measured affine fit")
+            values.append(modeled)
+        return tuple(values[rank // 8] for rank in range(16)), 0.0
+    for rank in range(16):
+        own_rows, total_rows = sizes[rank // 8], sum(sizes)
+        copies = params["copy"][str(rank)]
+        for tensor in tensors:
+            row_bytes = tensor["columns"] * tensor["element_size"]
+            copy = copies[tensor["name"]]
+            own, total = own_rows * row_bytes, total_rows * row_bytes
+            _affine_service(copy, total / 2)
+            if phase == "dispatch":
+                _affine_service(copy, own)
+            else:
+                _affine_service(copy, own)
+                _affine_service(params["reduce"][str(rank)], own)
+    feature = sum(sizes) * sum(t["columns"] * t["element_size"] for t in tensors)
+    remainder = _affine_service(params["protocol"], feature, positive_slope=False)
+    return plan_memory_service_ms(plan,params["copy"],params["reduce"]), remainder
+
+
+def plan_memory_service_ms(plan, copies, reductions):
+    """One frozen HBM proxy equation, also used before candidate remainder fitting."""
+    per_rank=[]
+    for rank in range(16):
+        value=0.
+        for tensor in plan["tensors"]:
+            row_bytes=tensor["columns"]*tensor["element_size"]
+            own=plan["sizes"][rank//8]*row_bytes
+            copy=copies[str(rank)][tensor["name"]]
+            local=copy if plan["phase"] == "dispatch" else reductions[str(rank)]
+            value+=local["a_ms"]+local["b_ms_per_byte"]*own
+            value+=copy["b_ms_per_byte"]*sum(plan["sizes"])*row_bytes/2
+        per_rank.append(value)
+    return tuple(per_rank)
+
+
