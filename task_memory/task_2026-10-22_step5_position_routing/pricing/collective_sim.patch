+def lower_collective_plan(spec: CollectiveSpec, groups):
+    """Ordered group-local stages in one matrix, exact element channel stripes."""
+    sys.path.insert(0, str(REPO_ROOT / "python"))
+    from collective_sim_core.schema import validate_collective_plan
+    plan = spec.plan
+    validate_collective_plan(plan)
+    if [list(g) for g in plan["groups"]] != [list(g) for g in groups]:
+        raise ValueError("Explicit Step groups disagree with existing placement")
+    if not spec.use_triggers or plan["phase"] not in ("dispatch", "combine"):
+        raise ValueError("Network lowering requires triggered DP dispatch/combine")
+    selector = spec.allgather_model if plan["phase"] == "dispatch" else spec.reducescatter_model
+    if selector not in ("ring_steps", "nccl_ring") or spec.nchannels <= 0:
+        raise ValueError("Unsupported frozen Step channel model")
+    channels = 1 if selector == "ring_steps" else spec.nchannels
+    flows, triggers = [], []
+    for group in groups:
+        release = None
+        for index, (primitive, tensor_index, root) in enumerate(plan["stages"]):
+            tensor = plan["tensors"][tensor_index]
+            directions = ((0, 1), (1, 0)) if root is None else (
+                ((root, 1-root),) if primitive == "Broadcast" else ((1-root, root),))
+            stage = []
+            for src, dst in directions:
+                owner = src if primitive in ("Broadcast", "AllGather") else dst
+                elements = plan["sizes"][owner] * tensor["columns"]
+                quotient, remainder = divmod(elements, channels)
+                for channel in range(channels):
+                    count = quotient + (channel < remainder)
+                    if count:
+                        stage.append((group[src], group[dst], count * tensor["element_size"]))
+            done = len(triggers) + 1 if index + 1 < len(plan["stages"]) else None
+            if done is not None:
+                triggers.append(TriggerDef(done, "barrier", len(stage)))
+            flows.extend(FlowDef(src, dst, size, start=0 if release is None else None,
+                         trigger=release, send_done_trigger=done) for src, dst, size in stage)
+            release = done
+    return flows, triggers
+
+
