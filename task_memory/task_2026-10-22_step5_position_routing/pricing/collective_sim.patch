@@ -0,0 +1,105 @@
+"""Real serialized lowering and independent numerical proxy checks (CPU only)."""
+from dataclasses import replace
+from pathlib import Path
+import sys
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "python"))
+sys.path.insert(0, str(ROOT))
+from collective_sim_core.schema import (Scenario, ClusterConfig, ParallelismConfig,
+    CollectiveConfig, validate_collective_plan)
+from collective_sim_core.intra_server_model import estimate_plan_local_ms
+from htsim_runner import CollectiveSpec, generate_tm_from_spec, lower_collective_plan
+
+
+def workload(sizes=(16, 1), phase="dispatch"):
+    tensors = [{"name":n, "dtype":d, "columns":c, "element_size":b, "row_stride":c}
+        for n,d,c,b in (("activation","float8_e4m3fn",4096,1),
+        ("weights","float32",8,4),("ids","int32",8,4),("scales","float32",32,4))]
+    if phase != "dispatch":
+        tensors = [{"name":"output", "dtype":"bfloat16", "columns":4096,
+                    "element_size":2, "row_stride":4096}]
+    uniform = sizes[0] == sizes[1]
+    primitive = ("AllGather" if phase == "dispatch" else "ReduceScatter") if uniform else (
+                 "Broadcast" if phase == "dispatch" else "Reduce")
+    return dict(phase=phase, sizes=sizes, tensors=tensors, groups=[[t,8+t] for t in range(8)],
+        graph_mode="none", context={"evidence_kind":"cpu_fixture"}, buffers={"ordinary":True},
+        stages=[[primitive,j,r] for j in range(len(tensors)) for r in ((None,) if uniform else (0,1))])
+
+
+def affine(a=1., b=.001):
+    return dict(a_ms=a, b_ms_per_byte=b, range_bytes=[1,100000000], design_matrix_rank=2,
+        distinct_sizes=3, calibration_receipt="cpu_fixture", signed_residuals_ms=[-.1,.2,0.],
+        qualification={"status":"PASS", "independent":True,"observations":["cpu_fixture"]})
+
+
+def scenario(plan):
+    params = dict(context=plan["context"], model_identity="cpu_fixture", evidence_kind="cpu_fixture",
+        copy={str(r):{d:affine() for d in ("activation","weights","ids","scales","output")}
+              for r in range(16)}, reduce={str(r):affine(2.) for r in range(16)}, protocol=affine(3.,0.))
+    return Scenario(ClusterConfig(2,8), ParallelismConfig(tp=8,dp=2), collective=CollectiveConfig(
+        kind="plan", tensor_bytes=0, domain_dims=("DP",), placement_order=("TP","DP"),
+        intra_server_combine_rule="sum", plan=plan, local_parameters=params))
+
+
+@pytest.mark.parametrize("sizes,phase", [((16,1),"dispatch"),((1,16),"combine"),
+                                        ((1,1),"dispatch"),((1,1),"combine")])
+def test_serialized_lowering_conservation_dependencies_and_joint_rails(tmp_path,sizes,phase):
+    plan = workload(sizes,phase)
+    sc = scenario(plan)
+    serial = sc.to_runner_spec()
+    assert serial["collective"]["plan"] == plan
+    spec = CollectiveSpec("plan", ("DP",), ("TP","DP"), True, plan=plan,
+                          use_triggers=True,nchannels=11,allgather_model="nccl_ring",reducescatter_model="nccl_ring")
+    flows, barriers = lower_collective_plan(spec,plan["groups"])
+    assert all(f.size > 0 for f in flows)
+    assert sum(f.size for f in flows) == 8*sum(sizes)*sum(t["columns"]*t["element_size"] for t in plan["tensors"])
+    assert {f.src % 8 for f in flows if f.start == 0} == set(range(8))
+    for barrier in barriers:
+        producers = [f for f in flows if f.send_done_trigger == barrier.id]
+        consumers = [f for f in flows if f.trigger == barrier.id]
+        assert len(producers) == barrier.count and consumers
+        assert len({f.src % 8 for f in producers+consumers}) == 1
+    path,count = generate_tm_from_spec(tmp_path,spec=spec,nodes=16,servers=2,gpus_per_server=8,
+        tp=8,cp=1,dp=2,ep=1,tensor_bytes=0,seed=1)
+    assert count == len(flows) and "size 0" not in path.read_text()
+    assert len(barriers) == 8*(len(plan["stages"])-1)
+
+
+def test_local_proxy_and_signed_fit_evidence_are_not_zero_or_clipped():
+    sc=scenario(workload())
+    ranks,remainder=estimate_plan_local_ms(sc)
+    rowbytes=4288
+    assert ranks[0] == pytest.approx(4+.001*16*rowbytes+.001*17*rowbytes/2)
+    assert ranks[8] == pytest.approx(4+.001*rowbytes+.001*17*rowbytes/2)
+    assert remainder == 3. and sc.collective.local_parameters["protocol"]["signed_residuals_ms"][0] < 0
+    sc.collective.local_parameters["copy"]["0"]["weights"]["b_ms_per_byte"]=0
+    with pytest.raises(ValueError,match="coefficients"):
+        estimate_plan_local_ms(sc)
+
+
+def test_plan_rejects_scalar_override_missing_stages_and_wrong_placement():
+    sc=scenario(workload())
+    with pytest.raises(ValueError,match="scalar"):
+        replace(sc,collective=replace(sc.collective,tensor_bytes=1)).validate()
+    plan=workload(); plan["stages"].pop()
+    with pytest.raises(ValueError,match="stages"):
+        validate_collective_plan(plan)
+    with pytest.raises(ValueError,match="layout"):
+        replace(sc,parallelism=ParallelismConfig(tp=4,dp=4)).validate()
+
+
+def test_actual_htsim_completes_all_joint_flows_and_composes_the_result(tmp_path):
+    if not (ROOT / "sim/datacenter/htsim_ndp").exists():
+        pytest.skip("HTSIM binary is unavailable; lowering tests still execute")
+    from collective_sim_core import predict_collective_time
+    from collective_sim_core.schema import RunnerConfig, TopologyConfig
+    sc=replace(scenario(workload()), runner=RunnerConfig(out_dir=str(tmp_path),stop_on_finished=True),
+               topology=TopologyConfig(kind="rail",servers_per_tor=1))
