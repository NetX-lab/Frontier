+class _PDExecution:
+    """Dispatch every returned DES event; retain the queue at observation boundaries."""
+
+    def __init__(self, scheduler, metrics=None):
+        self.scheduler = scheduler
+        self.metrics = metrics or _ExecutionMetrics()
