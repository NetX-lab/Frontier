diff --git a/vllm/distributed/parallel_state.py b/vllm/distributed/parallel_state.py
index 128db903d..6af2bc4cc 100644
--- a/vllm/distributed/parallel_state.py
+++ b/vllm/distributed/parallel_state.py
@@ -1626,7 +1626,10 @@ def init_distributed_environment(
             distributed_init_method = get_distributed_init_method(ip, port)
         else:
             ip = parallel_config.data_parallel_master_ip
-            port = parallel_config.get_next_dp_init_port()
+            port = (
+                parallel_config._coord_store_port
+                or parallel_config.get_next_dp_init_port()
+            )
             distributed_init_method = get_distributed_init_method(ip, port)
             logger.debug(
                 "Adjusting world_size=%d rank=%d distributed_init_method=%s for DP",
@@ -1657,7 +1660,25 @@ def init_distributed_environment(
             )
             backend = "gloo"
         store = None
-        if distributed_init_method.startswith("file://"):
+        if (
+            config is not None
+            and not enable_elastic_ep
+            and config.parallel_config._coord_store_port
+            and config.parallel_config.nnodes == 1
+            and config.parallel_config.data_parallel_size > 1
+            and config.parallel_config.distributed_executor_backend != "external_launcher"
+        ):
+            # The launcher owns this listener before the engines handshake.
+            # Worker-world keys must not overlap the engine Gloo group.
+            parallel_config = config.parallel_config
+            store = torch.distributed.PrefixStore(
+                "dp_worker_world",
+                get_cached_tcp_store_client(
+                    parallel_config.data_parallel_master_ip,
+                    parallel_config._coord_store_port,
+                ),
+            )
+        elif distributed_init_method.startswith("file://"):
             store = torch.distributed.FileStore(
                 distributed_init_method.removeprefix("file://"), world_size
             )
